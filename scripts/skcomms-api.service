# SKComms REST API — systemd user service
#
# Runs the SKComms FastAPI server as a persistent background service
# under the current user account (no root required).
#
# INSTALL
# -------
#   mkdir -p ~/.config/systemd/user
#   cp scripts/skcomms-api.service ~/.config/systemd/user/skcomms-api.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now skcomms-api
#
# MANAGE
# ------
#   systemctl --user status skcomms-api
#   systemctl --user restart skcomms-api
#   systemctl --user stop skcomms-api
#   journalctl --user -u skcomms-api -f          # follow logs
#   journalctl --user -u skcomms-api --since today
#
# EXPOSE TO LAN (optional)
# ------------------------
#   Override the bind host by editing the ExecStart line:
#     --host 0.0.0.0   → listen on all interfaces (use a firewall!)
#     --host 192.168.1.x → bind to a specific LAN interface
#
# ENABLE LINGER (survive logout)
# -------------------------------
#   loginctl enable-linger $USER
#
# ENVIRONMENT OVERRIDES
# ---------------------
#   Drop a file at ~/.config/skcomms-api.env and reference it in
#   EnvironmentFile below to set SKCOMMS_HOME, LOG_LEVEL, etc.

[Unit]
Description=SKComms REST API Server (port 9384)
Documentation=https://github.com/smilinTux/smilinTux-org
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- Identity / working directory ---
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal

# --- Optional environment file (create if you need overrides) ---
# EnvironmentFile=-%h/.config/skcomms-api.env

# --- Environment ---
Environment="PYTHONUNBUFFERED=1"
Environment="LOG_LEVEL=info"

# --- Command ---
# Uses the `skcomms serve` CLI so it respects ~/.skcomms/config.yml automatically.
# If skcomms is installed in a virtualenv, replace the ExecStart path accordingly:
#   ExecStart=/path/to/venv/bin/skcomms serve --host 127.0.0.1 --port 9384
ExecStart=%h/.pyenv/shims/skcomms serve --host 127.0.0.1 --port 9384

# --- Resilience ---
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# --- Security hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.skcomms %h/.skcapstone

[Install]
WantedBy=default.target
